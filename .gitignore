/target
*.dict.tmp
user.redb*
*.corrupt.*
/logs

# The fuzz crate is a separate workspace root with its own build directory; the
# root-anchored `/target` above does not cover it.
/fuzz/target

# Dictionary sources fetched by data/fetch.sh. They are reproducible from the
# digests pinned in data/sources.toml, so the upstream copies stay out of the
# repository; only the derived artifacts below are committed.
/data/raw/*.tsv
!/data/raw/base.tsv
!/data/raw/polyphone.tsv

# The compiled dictionary is a build artifact, regenerated by `xtask dictc`.
*.dict
/data/compiled
