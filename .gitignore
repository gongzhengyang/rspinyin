/target
*.dict.tmp
user.redb*
*.corrupt.*
/logs

# The fuzz crate is a separate workspace root with its own build directory; the
# root-anchored `/target` above does not cover it.
/fuzz/target

# The release directory `just package` writes: the archive, the release manifest and
# SHA256SUMS. Build output, never a source.
/dist

# The evidence tree the automated test platform writes: screenshots, transcripts,
# snapshots and traces, one directory per case. It holds what a run observed -- which
# includes the text a case typed -- so it is an artifact of a run and never a source.
/results

# Dictionary sources fetched by data/fetch.sh. They are reproducible from the
# digests pinned in data/sources.toml, so the upstream copies stay out of the
# repository; only the derived artifacts below are committed.
#
# These rules are load-bearing and are not relaxed to make a checkout build the
# dictionary offline: committing the fetched sources or the compiled dictionary would
# bypass the allowlist model scripts/check-dict-sources.sh enforces (ADR-0000 decision
# 2). Offline installs are served by shipping the compiled base.dict in a release
# archive, so an end user never runs the fetch script at all.
/data/raw/*.tsv
!/data/raw/base.tsv
!/data/raw/polyphone.tsv
# The mixed-English word list and the confusable table are curated in this
# repository rather than fetched: they are project-owned derived sources
# (data/sources.toml, kind="derived"), and a checkout without them cannot
# rebuild eng.dict or serve the wrong-word hints.
!/data/raw/melt-eng.tsv
!/data/raw/confusable.tsv
# The symbol-panel categories are curated here for the same reason.
!/data/raw/symbols.tsv

# The zh-Wikipedia corpus is fetched for bigram generation only (ADR-0012).
# It never enters the repository or a release payload; only statistics are compiled.
/data/raw/corpus/

# The compiled dictionary is a build artifact, regenerated by `xtask dictc`.
*.dict
/data/compiled
