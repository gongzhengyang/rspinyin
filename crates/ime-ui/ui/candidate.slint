// Candidate window skeleton: the floating panel, its header strip, the candidate area and
// the two-layer shadow that makes it read as a panel rather than a rectangle.
//
// Every geometry value of docs/dev/features.md 3.1 is declared once, in the
// `CandidateMetrics` global below. `src/layout.rs` parses those lines out of this file
// instead of restating them in Rust, and the spec audit script compares the same lines
// against the 3.1 tables, so a size can never drift between what is drawn and what is
// computed. Keep the block's shape: one scalar metric per line, spelled
// `out property <length> kebab-case-name: <value>px;`.
//
// Units are logical pixels: Slint's `px` is this project's `dp`. Device pixels never
// appear here, the renderer applies `Window.scale-factor` (ASM-09), so one file drives
// 1x and 2x displays.
//
// This window must never take keyboard focus. No `TextInput`, no `forward-focus` and no
// `focus()` call may appear in this file or in anything it includes.
//
// The file is declaration only: no branch over candidate data, no string formatting and
// no measurement lives here. Everything the window draws arrives already resolved, which
// is what keeps the render path a pure function of the frame.

import { CandidateData, CandidateGrid } from "candidate_grid.slint";
import { OverlayPanel, OverlaySectionData } from "overlay.slint";
import { Theme } from "theme.slint";

// Re-exported, and that is not cosmetic. `slint_build::compile` generates Rust only for
// the roots reachable from the file it was handed: the `Window` component and the globals
// *declared in this file*. A global that this file merely imports stays private to the
// import graph and gets no Rust accessor, so `slint::include_modules!()` produced a module
// with `CandidateWindow` and `CandidateMetrics` and no `Theme` at all -- which is why
// `src/adapter.rs` could not write the palette into the component. Re-exporting makes the
// global a root of this file, and the accessor appears. `CandidateData` is re-exported for
// the same reason: the adapter builds the model the grid draws from.
export { Theme } from "theme.slint";
export { CandidateData } from "candidate_grid.slint";
// The overlay's row structs are re-exported for the same reason `CandidateData` is: the
// adapter builds the model the overlay panel draws from, and only the roots of this file
// get Rust accessors.
export { OverlayEntryData, OverlaySectionData } from "overlay.slint";

// One run of the preedit line, as the header draws it.
//
// The span list is what `ime_types::Preedit::spans` already is; `src/adapter/` only flattens
// it, lifts the caret out of it and cuts the head that does not fit. `kind` is the wire
// value of `ime_types::SpanKind` -- 0 syllable, 1 separator, 2 passthrough -- and the cursor
// is deliberately not one of the values: a zero-width run would take a slot in the layout
// that the caret has to share with the text on either side of it.
export struct PreeditRun {
    text: string,
    kind: int,
}

// Geometry, material and type-scale constants (3.1.1 - 3.1.4).
export global CandidateMetrics {
    // -- window geometry (3.1.1) --------------------------------------------
    out property <length> shadow-margin: 32px;
    out property <length> stroke-width: 1px;
    out property <length> container-radius: 12px;
    out property <length> container-padding: 8px;
    out property <length> min-width: 220px;
    out property <length> max-width: 720px;

    // -- header (3.1.1) -----------------------------------------------------
    out property <length> header-height: 34px;
    out property <length> header-height-compact: 28px;
    out property <length> header-padding-h: 10px;
    out property <length> header-icon-size: 16px;
    out property <length> header-icon-gap: 8px;
    out property <length> header-text-gap: 6px;
    out property <length> separator-height: 1px;

    // -- candidate grid (3.1.1) ---------------------------------------------
    out property <length> cell-min-width: 64px;
    out property <length> cell-height: 36px;
    out property <length> cell-padding-h: 10px;
    out property <length> cell-padding-v: 6px;
    // Concentric with the container: a cell nested `container-padding` inside a container of
    // radius `container-radius` reads as the same curve only at `12 - 8 = 4dp`. Anything
    // rounder looks like a sticker floating on the panel, which is what the earlier 8dp value
    // produced at the grid's corners. 3.1.1 states the derivation, not just the number.
    out property <length> cell-radius: 4px;
    out property <length> number-gap: 6px;
    // The slot the number label occupies, and the reason it is a slot rather than the
    // glyph's own advance: digits do not all advance by the same amount, so a label that
    // hugged its glyph would start the candidate text at a different x on every cell and
    // the row would read as ragged. 8dp is the 11sp digit's advance rounded up to the 4dp
    // grid of 3.1.4, and `cell-chrome-width` below already budgets for it.
    out property <length> number-slot-width: 8px;
    out property <length> annotation-gap: 6px;
    out property <length> grid-gap: 6px;

    // -- cursor arrow (3.1.1) -----------------------------------------------
    // Drawn by the geometry task, which is the only place that knows whether the window
    // was flipped or clamped; the sizes live here so there is one place to read them.
    out property <length> cursor-arrow-width: 12px;
    out property <length> cursor-arrow-height: 6px;

    // -- material (3.1.2) ---------------------------------------------------
    // L3's `0 8dp 28dp`: the blur radius the bands tile outward from the panel edge, and the
    // distance down they are shifted by.
    out property <length> shadow-blur: 28px;
    out property <length> shadow-offset-y: 8px;
    // L2's `0 1dp 2dp`: two bands spreading 2dp past the panel edge. The spread is the
    // specification's 2dp and not the blur rounded up to the 4dp grid, because a wider ring
    // reads as an outline drawn around the panel rather than as the panel's own edge
    // darkening, which is the one thing this layer exists to avoid.
    out property <length> shadow-inner-spread: 2px;
    out property <length> shadow-inner-offset-y: 1px;
    // Eight bands of 3.5dp tile the 28dp blur. Four left the steps visible at the 1.0 scale
    // factor this window has to support; eight is the fewest that reads as a gradient, and
    // the cost follows the panel's perimeter rather than its area because each band paints a
    // ring and not a filled rectangle.
    out property <int> shadow-band-count: 8;
    // The peak of L3's falloff: the alpha of the band that hugs the panel. The bands outside
    // it carry the square of their position in the ramp, which is the tail a Gaussian blur of
    // a straight edge leaves behind, and the ramp itself is painted from
    // `Theme.shadow-outer-bands` -- this file draws it but does not compute it: the falloff
    // lives in the per-band colours, and one element opacity could not express their
    // square-law ramp.
    out property <float> shadow-band-opacity: 0.18;
    // How many bands L2 is drawn as, and the share of `shadow-inner`'s own alpha the band
    // against the panel carries. Two 1dp rings rather than one 2dp ring: a single thick ring
    // has a visible inner boundary where it meets the panel, which is the outline the layer
    // is meant to avoid. The bands themselves are `Theme.shadow-inner-bands`.
    out property <int> shadow-inner-band-count: 2;
    out property <float> shadow-inner-opacity: 0.75;

    // -- truncation and paging (3.1.3) --------------------------------------
    out property <length> max-text-width: 120px;
    // Everything a candidate cell spends on something other than its text: 2 x 10dp
    // padding, the number label and its 6dp gap, rounded to the 4dp grid. A cell whose
    // text hits `max-text-width` therefore stops at 120 + 36 = 156dp.
    out property <length> cell-chrome-width: 36px;
    out property <int> max-pages: 5;

    // -- candidates per row (3.1.1) -----------------------------------------
    out property <int> min-per-row: 3;
    out property <int> max-per-row: 5;
    out property <int> max-per-row-limit: 9;

    // -- type scale (3.1.1, 3.1.4); `sp` and `dp` are the same unit here -----
    out property <length> font-size-header: 14px;
    out property <length> font-size-cell: 15px;
    out property <length> font-size-small: 11px;
}

// The two material layers behind the panel (3.1.2): L3, the soft outer shadow that gives the
// window its height, and L2, the tight inner shadow that keeps the acrylic surface from
// blurring into whatever sits behind it.
//
// Slint's `drop-shadow-*` is deliberately unused: the software renderer's `draw_box_shadow`
// is a stub, so a `drop-shadow-blur` rectangle would draw no shadow at all under the renderer
// this project ships. The layers are built from concentric rounded rings instead, and each
// ring paints only its own band, so the cost follows the panel's perimeter rather than its
// area.
//
// Two properties make the rings read as a blur rather than as a halo, and both are load
// bearing:
//
//  * the rings tile outward without overlapping, so the composite alpha at any point is
//    exactly the alpha of the single ring covering it. The falloff therefore has to live in
//    the per-band colour; stacking more bands at one alpha produces a flat wash with a hard
//    outer edge, which is what an earlier revision of this file did.
//  * the alpha follows the square of the band's position, which is the tail a Gaussian blur
//    of a straight edge leaves behind. A linear ramp reads visibly too bright in the middle
//    of the falloff.
//
// The ramp is carried by `Theme.shadow-outer-bands` and `Theme.shadow-inner-bands` rather
// than by an `opacity` here, and the reason is the shape of the ramp, not a renderer
// limitation: the bands tile outward without overlapping, so the composite alpha at any
// point is the alpha of the single band covering it, while an element opacity is one
// multiplier for the whole layer and would scale the falloff away with it. That the
// renderer does honour a bound opacity besides is pinned by the pixel probes in
// `src/renderer/tests.rs`. The two tables are the per-band colours themselves, in the order
// these loops walk them, and `src/theme/slint_palette.rs` and `src/theme/tests.rs` hold
// them to the falloff and the peak that 3.1.2 describes.
export component CandidateShadow inherits Rectangle {
    in property <length> container-width: CandidateMetrics.min-width;
    in property <length> container-height: 0px;
    in property <length> container-radius: CandidateMetrics.container-radius;

    background: transparent;

    // The width of one outer band: the 28dp blur divided into as many steps as the layer
    // counts. The rings are only gapless while this divides the blur exactly.
    private property <length> band-step:
        CandidateMetrics.shadow-blur / CandidateMetrics.shadow-band-count;
    // The width of one inner band, which is the 2dp spread over two 1dp bands.
    private property <length> inner-band-step:
        CandidateMetrics.shadow-inner-spread / CandidateMetrics.shadow-inner-band-count;

    // L3: the soft layer. Band 0 is the outermost and faintest; the last band hugs the panel
    // and carries the peak alpha, so the ramp accumulates towards the edge. Each band is a
    // ring `band-step` wide, inflated so that its outer edge sits at the band's own distance
    // from the panel -- which is what makes the rings tile the blur exactly instead of
    // overlapping into a flat wash.
    for band in CandidateMetrics.shadow-band-count: Rectangle {
        private property <length> spread:
            (CandidateMetrics.shadow-band-count - band) * root.band-step;
        x: 0px - self.spread;
        y: CandidateMetrics.shadow-offset-y - self.spread;
        width: root.container-width + 2 * self.spread;
        height: root.container-height + 2 * self.spread;
        border-radius: root.container-radius + self.spread;
        background: transparent;
        border-width: root.band-step;
        border-color: Theme.shadow-outer-bands[band];
    }

    // L2: the hard edge, declared last so it stays closest to the panel. Two 1dp rings rather
    // than one 2dp ring: a single thick ring has a visible inner boundary where it meets the
    // panel, which is the outline this layer exists to avoid.
    for band in CandidateMetrics.shadow-inner-band-count: Rectangle {
        private property <length> spread:
            (CandidateMetrics.shadow-inner-band-count - band) * root.inner-band-step;
        x: 0px - self.spread;
        y: CandidateMetrics.shadow-inner-offset-y - self.spread;
        width: root.container-width + 2 * self.spread;
        height: root.container-height + 2 * self.spread;
        border-radius: root.container-radius + self.spread;
        background: transparent;
        border-width: root.inner-band-step;
        border-color: Theme.shadow-inner-bands[band];
    }
}

// The header's status cluster (3.1.1: four 16dp markers, 8dp apart). It is a fixed-size
// block -- `4 * icon + 3 * gap`, declared once -- so the preedit text beside it keeps the
// same budget when a mode toggles and the header cannot jump sideways. A marker that is
// off is drawn at the idle token rather than hidden, which is what makes that width
// constant; the mode label carries the words, this carries the glance. The two secondary
// markers are the one thing that can be dropped, and only when the preedit has no room
// left; see `show-secondary`.
export component StatusCluster inherits Rectangle {
    in property <bool> chinese: true;
    in property <bool> full-width: false;
    in property <bool> punctuation-full: false;
    in property <bool> readonly: false;
    // Whether the two secondary markers are drawn. A header whose preedit has almost no room
    // left keeps the mode and the lock and drops the other two: those two are what the user
    // has to know, the others are what he occasionally wants to. Dropping them takes 48dp
    // off the cluster, which is exactly what the adapter gives back to the preedit when it
    // decides the same thing -- the two halves are one decision.
    in property <bool> show-secondary: true;
    // The height of the row the cluster is placed in, which is the header's own height.
    in property <length> strip-height: CandidateMetrics.header-height;

    background: transparent;
    // The cluster is a fixed-size block: `4 * icon + 3 * gap` with both markers drawn, and
    // `2 * icon + 1 * gap` with the two secondary ones dropped. Its width never depends on
    // *which* modes are on, which is what keeps a mode toggle from reflowing the preedit and
    // making the header jump sideways.
    width: root.show-secondary
        ? 4 * CandidateMetrics.header-icon-size + 3 * CandidateMetrics.header-icon-gap
        : 2 * CandidateMetrics.header-icon-size + CandidateMetrics.header-icon-gap;
    // As tall as the row, with the markers placed on the row's optical centre below. A block
    // that kept its own 16dp height would be a fixed-size child of a taller row, which the
    // layout places at the row's start -- 8dp above the line the preedit and the status text
    // beside it sit on.
    height: root.strip-height;

    HorizontalLayout {
        // The markers and the layout they sit in share one height, so the cross axis is exact
        // whether the layout stretches a child or leaves it at its own size.
        y: (parent.height - CandidateMetrics.header-icon-size) / 2;
        spacing: CandidateMetrics.header-icon-gap;
        height: CandidateMetrics.header-icon-size;

        // Mode dot: solid accent in Chinese mode, the idle token in English mode.
        Rectangle {
            width: CandidateMetrics.header-icon-size;
            height: CandidateMetrics.header-icon-size;
            border-radius: self.width / 2;
            background: root.chinese ? Theme.status-dot-active : Theme.status-dot-idle;
        }

        // Full-width marker: the same disc, ringed only while full-width punctuation is on.
        Rectangle {
            visible: root.show-secondary;
            width: CandidateMetrics.header-icon-size;
            height: CandidateMetrics.header-icon-size;
            border-radius: self.width / 2;
            border-width: 2px;
            border-color: root.full-width ? Theme.status-dot-active : Theme.status-dot-idle;
            background: transparent;
        }

        // Chinese-punctuation marker.
        Rectangle {
            visible: root.show-secondary;
            width: CandidateMetrics.header-icon-size;
            height: CandidateMetrics.header-icon-size;
            border-radius: self.width / 2;
            border-width: 2px;
            border-color: root.punctuation-full ? Theme.status-dot-active : Theme.status-dot-idle;
            background: transparent;
        }

        // Read-only lock, drawn only in the degraded mode of 3.6. It takes the annotation token
        // because a read-only store is information rather than an alert.
        //
        // Gated by its colour rather than by an `opacity`, which is the rule this file follows
        // for a binary state: the renderer does honour a bound opacity -- the pixel probes in
        // `src/renderer/tests.rs` pin that -- but compositing a subtree on every frame to
        // express an on/off that a transparent colour already expresses for free is cost
        // without a visual. The disc keeps its slot in the cluster whichever way the flag
        // reads, which is what holds the four markers at one width.
        Rectangle {
            width: CandidateMetrics.header-icon-size;
            height: CandidateMetrics.header-icon-size;
            border-radius: 4px;
            border-width: 1px;
            border-color: root.readonly ? Theme.text-annotation : transparent;
            background: transparent;
        }
    }
}

// One run of the preedit, styled by what it represents.
//
// The separator is the reason this is a component rather than a single text element: a
// pinyin string is far easier to read when its syllable boundaries are visible, and
// `ni'hao'a` collapses into one unreadable run the moment the separators are drawn at the
// same weight as the syllables. 3.1.1 gives them a token of their own for exactly that
// reason. A passthrough run is not pinyin at all -- it is the input shown as it was typed,
// because the segmentation found no reading for it -- so it takes the secondary token and
// reads as the weaker of the three.
component PreeditSpan inherits Text {
    in property <PreeditRun> run;

    text: root.run.text;
    font-family: Theme.font-family;
    font-size: CandidateMetrics.font-size-header;
    // Syllables are 500; separators and passthrough runs are 400 (3.1.1).
    font-weight: root.run.kind == 0 ? 500 : 400;
    color: root.run.kind == 0 ? Theme.text-primary
        : root.run.kind == 1 ? Theme.text-separator
        : Theme.text-secondary;
    vertical-alignment: center;
    overflow: elide;
    wrap: no-wrap;
}

// The header strip: the preedit on the left, the status cluster on the right.
//
// 3.1.3 cuts a preedit that does not fit from the *left*, keeping the newest input: the user
// is typing the tail, so the head is the half that can be spared. The cut itself happens in
// `src/adapter/`, which is the only layer that can estimate a width, and it arrives here as
// a run list that already fits plus a `truncated` flag. The strip's own job is to draw the
// caret where the span list says it is, and to fade the edge a cut left behind.
export component Header inherits Rectangle {
    // The preedit split around the caret: everything left of it, and everything right of it.
    // Splitting in the adapter rather than positioning a caret at a measured offset is what
    // makes a caret in the middle of the string work without any measurement on this side.
    in property <[PreeditRun]> before: [];
    in property <[PreeditRun]> after: [];
    // Whether the caret is drawn at all. False only when the cut took the caret with it,
    // which is the one case where its position is not on screen.
    in property <bool> caret-visible: false;
    // Whether a prefix was dropped to make the preedit fit.
    in property <bool> truncated: false;

    in property <string> mode-label: "";
    // 3.6's input-limit state: the preedit sits at the character ceiling, so further keys
    // are dropped. The hint says so beside the status cluster instead of leaving the
    // user to read silence as breakage.
    in property <bool> input-full: false;
    in property <bool> full-width: false;
    in property <bool> punctuation-full: false;
    in property <bool> readonly: false;
    // The mode bit behind the cluster's first marker (`StatusStrip::chinese`,
    // ADR-0005). It travels beside the flags rather than being read off `mode-label`:
    // that slot carries the mode's own text or a degradation notice, so nothing about
    // the mode can be inferred from it.
    in property <bool> chinese: false;
    // Whether the cluster's two secondary markers are drawn; see `StatusCluster`. The
    // adapter decides it from the room the preedit has left, and the cluster's width and the
    // preedit's budget are the two halves of that one decision.
    in property <bool> show-secondary-status: true;

    // Driven by the window: 3.1.1 compresses the strip to 28dp for a preedit-only window.
    in property <length> strip-height: CandidateMetrics.header-height;

    background: transparent;
    height: root.strip-height;

    HorizontalLayout {
        // The strip's text starts half a pixel lower than the layout would place it, which is
        // the window's optical nudge (`Theme.optical-nudge`) and the same shift the candidate
        // cells take: the two lines then share one optical baseline. The shift belongs to the
        // layout and not to a text element, because Slint gives an element *inside* a layout
        // its position from the layout and rejects a binding of its own.
        y: Theme.optical-nudge;
        // The preedit starts on the candidate grid's left axis: 3.1.1's sketch draws
        // `ni'hao'a` and the first cell's edge in one column, and the strip spans the panel's
        // full width, so the strip's own left inset is the padding the grid insets its cells
        // by. `header-padding-h` is not that number -- 3.1.1 gives the strip 10dp and the
        // candidate area 8dp, and taking the strip's own padding here would put the first
        // glyph 2dp to the right of the first cell's edge.
        padding-left: CandidateMetrics.container-padding;
        // The right side keeps the strip's own 10dp: the status cluster is the last thing on
        // the line and must not sit against the container edge.
        padding-right: CandidateMetrics.header-padding-h;
        spacing: CandidateMetrics.header-text-gap;

        // The preedit takes whatever the cluster leaves. Its own left edge is where the fade
        // is anchored, so the overlay lives in this wrapper rather than beside the text in
        // the layout, and the wrapper is what clips a run the layout could not shrink. Its
        // height is the strip's own rather than whatever the layout would derive from the
        // runs, so the caret and the fade are measured against one line and the preedit
        // cannot sit on a different optical centre than the status text beside it.
        Rectangle {
            background: transparent;
            horizontal-stretch: 1;
            height: root.strip-height;
            clip: true;

            HorizontalLayout {
                spacing: 0px;

                for run in root.before: PreeditSpan { run: run; }

                // The caret sits exactly where the zero-width `SpanKind::Cursor` span was,
                // which is the whole reason the span list is ordered. It is gated by its own
                // colour rather than by an `opacity` or a `visible`: hiding it would take
                // it out of the layout and shift every glyph behind it by a pixel each time
                // the caret blinked, and an opacity would buy a per-frame compositing pass
                // for a blink the colour already switches for nothing -- the renderer does
                // honour a bound opacity (pinned by the pixel probes in
                // `src/renderer/tests.rs`), so the choice is cost, not capability.
                //
                // The slot is as tall as the row and the bar is centred in it explicitly, for
                // the reason `StatusCluster` is: a fixed-size child of a taller row is placed
                // by the layout's cross-axis alignment, and a caret on a different centre
                // from the text beside it is a caret drawn in the wrong place.
                Rectangle {
                    width: CandidateMetrics.stroke-width;
                    height: root.strip-height;
                    background: transparent;

                    Rectangle {
                        y: (parent.height - root.strip-height * 0.7) / 2;
                        width: parent.width;
                        height: root.strip-height * 0.7;
                        background: root.caret-visible ? Theme.accent : transparent;
                    }
                }

                for run in root.after: PreeditSpan { run: run; }
            }

            // The cut's affordance. Slint has no mask image, so the equivalent is an overlay
            // in the panel's own colour fading to nothing: whatever the cut left at the edge
            // is covered rather than clipped through. It is drawn only when something was
            // actually dropped, so a preedit that fits keeps its full contrast at the left
            // edge. The overlay is the panel's *fill* and not its base colour, because the
            // base is opaque and would paint a solid block over a translucent panel.
            if root.truncated: Rectangle {
                x: 0px;
                width: 8px;
                height: parent.height;
                background: @linear-gradient(90deg, Theme.surface-fill 0%, transparent 100%);
            }
        }

        // The status text of 3.1.1: the mode's own name, or the sentence a degraded state has
        // to say out loud -- 3.6 puts the dictionary-unavailable notice and the input-limit
        // notice here. It sits between the preedit and the cluster and takes its natural
        // width, which the adapter estimates before it cuts the preedit -- the estimate is a
        // generous one, so the text is never squeezed below the room the adapter budgeted.
        Text {
            text: root.mode-label;
            font-family: Theme.font-family;
            font-size: CandidateMetrics.font-size-small;
            font-weight: 500;
            color: Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }

        // 3.6's input-limit hint: one short phrase, no spinner and no colour alarm. It
        // borrows the small size the strip already draws at and sits to the cluster's
        // left, which is where 3.6 puts the state texts.
        if root.input-full: Text {
            text: "已达上限";
            font-family: Theme.font-family;
            font-size: CandidateMetrics.font-size-small;
            font-weight: 500;
            color: Theme.text-secondary;
            vertical-alignment: center;
            wrap: no-wrap;
        }

        // The status cluster is a fixed-width block (3.1.1: 16dp icons, 8dp apart). Its
        // width never depends on which modes are on, so toggling one cannot reflow the
        // preedit and the header never jitters. The mode dot reads the mode bit the engine
        // writes into every frame (`StatusStrip::chinese`, ADR-0005): the label slot beside
        // the cluster carries the mode's own text *or* a degradation notice, so its content
        // or emptiness answers nothing about the mode and must not be inferred from.
        StatusCluster {
            strip-height: root.strip-height;
            chinese: root.chinese;
            full-width: root.full-width;
            punctuation-full: root.punctuation-full;
            readonly: root.readonly;
            show-secondary: root.show-secondary-status;
        }
    }
}

// The candidate area is `CandidateGrid`, declared in `candidate_grid.slint` and placed by
// the window below. It is not declared here because it would then have to import this
// file for `CandidateMetrics`, which imports it.

// The candidate window. Sizes arrive from `src/layout.rs`, which owns every geometric
// decision; this component only places what it is given.
export component CandidateWindow inherits Window {
    // Frame data, resolved by the adapter.
    //
    // The preedit arrives split around the caret and already cut to fit, and the status
    // cluster arrives as the flags of `StatusStrip`. Nothing here decides any of it: the
    // header draws what it is handed, which is what keeps the render path a pure function of
    // the frame.
    in property <[PreeditRun]> preedit-before: [];
    in property <[PreeditRun]> preedit-after: [];
    in property <bool> caret-visible: false;
    in property <bool> preedit-truncated: false;
    in property <bool> show-secondary-status: true;
    in property <string> mode-label: "";
    in property <bool> full-width: false;
    in property <bool> punctuation-full: false;
    in property <bool> readonly: false;
    // The mode bit the cluster's dot draws (`StatusStrip::chinese`, ADR-0005), passed
    // through to the header untouched: the window derives nothing from it.
    in property <bool> chinese: false;
    // The page's candidates, in the model the grid draws from.
    in property <[CandidateData]> items: [];
    // Whether a candidate's annotation is drawn beside it. The adapter writes it from every
    // frame, and the default is the one `DrawState` starts from: the change detection
    // compares a frame against the state the component is already drawing, so the two have
    // to start out equal for a frame that turns the annotation off to take effect.
    in property <bool> show-annotation: false;

    // The modal overlay (ADR-0006), as the adapter resolved the engine's `OverlayFrame`.
    // While `overlay-visible` is true the panel below covers the candidates; the frame
    // beneath is left untouched, so clearing the overlay restores the candidate view
    // without a re-decode.
    in property <bool> overlay-visible: false;
    in property <string> overlay-title: "";
    in property <[OverlaySectionData]> overlay-sections: [];

    // Geometry, written by `src/layout.rs`. The geometry task reads `window-width` and
    // `window-height` to place and flip the window, and needs the shadow reserve included
    // because that is what the surface covers.
    in-out property <length> container-width: CandidateMetrics.min-width;
    in-out property <length> container-height: CandidateMetrics.header-height-compact
        + CandidateMetrics.separator-height
        + 2 * CandidateMetrics.container-padding;
    in-out property <length> container-radius: CandidateMetrics.container-radius;
    in-out property <length> header-height: CandidateMetrics.header-height;
    in property <int> item-count: 0;
    in property <int> max-per-row: CandidateMetrics.max-per-row;
    in property <int> grid-rows: 0;
    in property <length> cell-width: CandidateMetrics.cell-min-width;

    out property <length> window-width: root.container-width + 2 * CandidateMetrics.shadow-margin;
    out property <length> window-height: root.container-height + 2 * CandidateMetrics.shadow-margin;

    // -- motion (3.3) -------------------------------------------------------
    // Every motion property below is written once per frame by `src/adapter.rs` from the
    // spring integrator in `src/spring/`, which is fed the delta the UI thread measured.
    // Slint's own property-transition feature is deliberately unused in this file: its
    // internal clock would keep a timer alive while the window is at rest, which is exactly
    // what the idle CPU budget forbids, and it would make a rendered frame depend on how
    // many frames came before it, which the visual regression screenshots cannot tolerate.
    // Keeping the word out of the source entirely is also what makes a grep for it a
    // meaningful check: it can only ever match a declaration, never a comment about one.
    //
    // The four highlight values are relative to the candidate grid's own origin -- the space
    // the springs integrate in -- and the window adds the container padding and the header
    // block when it draws the box, which is the only place the two spaces meet.
    in property <length> highlight-x: 0px;
    in property <length> highlight-y: 0px;
    in property <length> highlight-w: 0px;
    in property <length> highlight-h: 0px;
    // Whether the engine has a candidate highlighted. This gates the box with `visible`
    // rather than with an opacity: the box is either on a cell or gone, and `visible`
    // takes it out of the draw and out of the damage entirely, which a zero-alpha subtree
    // would still pay to composite every frame. Continuous fades belong to the panel's
    // own binding below.
    in property <bool> highlight-visible: false;

    // 3.3.2's appear and disappear motion, in `0.0..=1.0` and `0.96..=1.0`. The panel
    // rectangle binds this to its own `opacity`, so the fade half of the motion reaches
    // the pixels: the software renderer folds a bound element opacity into the state
    // alpha -- the pixel probes in `src/renderer/tests.rs` pin that -- and `src/adapter.rs`
    // writes this property every frame the motion moves.
    in property <float> window-opacity: 1.0;
    in property <float> window-scale: 1.0;
    // Which edge the appear motion is anchored on. 3.3.2 anchors it on the cursor side: a
    // panel placed below the caret grows downward from its top edge, one placed above grows
    // upward from its bottom edge. Growing from the centre instead would slide the panel away
    // from the caret while it appeared. Written from the placement the geometry pass chose,
    // which is not always the side the anchor asked for.
    in property <bool> grows-upward: false;

    // 3.3.2's page-content slide: the candidate grid enters displaced by up to 12dp and
    // springs home. The header does not move -- the preedit did not change page.
    in property <length> page-offset-dp: 0px;

    // 3.6's input-limit state, bound down to the Header: the adapter computes it from
    // the preedit's own length, so the window needs no logic of its own.
    in property <bool> input-full: false;

    // The caret indicator (3.1.1), in container-relative dp. `arrow-visible` is false when
    // the placement pass declined to draw one -- a window that was flipped above the caret
    // or pushed sideways has no straight line back to it, and an arrow pointing the wrong
    // way is worse than none (`src/geometry/placement.rs`). The two coordinates are
    // meaningless while it is false and are then never read.
    in property <length> arrow-x: 0px;
    in property <length> arrow-y: 0px;
    in property <bool> arrow-visible: false;

    // The panel as the appear motion scales it, in container coordinates. Slint 1.13 has no
    // scale transform -- `Rectangle` carries no transform property at all -- so the scale is
    // drawn as geometry: the panel's own rectangle shrinks about the cursor-side edge and its
    // content is clipped to it.
    private property <length> panel-width: root.container-width * root.window-scale;
    private property <length> panel-height: root.container-height * root.window-scale;
    private property <length> panel-x: (root.container-width - root.panel-width) / 2;
    private property <length> panel-y: root.grows-upward
        ? root.container-height - root.panel-height
        : 0px;

    // The candidate cell's corner radius, and the highlight box's: one declaration for the
    // two, because a box rounder than the cell it covers reads as a border drawn in the
    // wrong place.
    //
    // 3.1.1 states the derivation and not only the number: the grid sits `container-padding`
    // inside the container, so the radius that reads as the same curve is the container's
    // minus that padding, which is the 4dp `CandidateMetrics.cell-radius` declares for the
    // 12dp default. Written as the difference, the relation survives `corner_radius_dp`
    // moving the container radius (3.1.1 allows 8..20); the table's value is the floor, so a
    // container shallower than its own padding still draws the rounded cell the table fixes
    // rather than a square one.
    private property <length> cell-radius: max(CandidateMetrics.cell-radius,
        root.container-radius - CandidateMetrics.container-padding);

    // Height of the candidate area: what the panel leaves below the header and its rule.
    //
    // A subtraction rather than the grid's own arithmetic, and that is the point. The rows,
    // the gaps between them and the padding around them belong to `src/layout.rs`, whose
    // `container_size` is what sized this panel; restating them here would be a second
    // definition of the one quantity the two sides have to agree on exactly, and the copy
    // that drifted would be the one that draws. Subtracting makes the panel's contents fill
    // it by construction instead: a frame whose rows and panel height disagreed would leave
    // a short candidate area rather than cells drawn past the panel.
    private property <length> grid-height: max(0px,
        root.container-height - root.header-height - CandidateMetrics.separator-height);

    // An overlay panel: no decorations, and a transparent surface so the shadow reserve
    // really is transparent (3.1.1) and can stay out of the input region.
    no-frame: true;
    background: transparent;
    width: root.window-width;
    height: root.window-height;

    // The material behind the panel. It carries the same scaled rectangle as the panel, so
    // the shadow shrinks with the panel rather than hanging in the reserve on its own.
    CandidateShadow {
        x: CandidateMetrics.shadow-margin + root.panel-x;
        y: CandidateMetrics.shadow-margin + root.panel-y;
        width: root.panel-width;
        height: root.panel-height;
        container-radius: root.container-radius;
    }

    // The caret indicator (3.1.1): a 12dp by 6dp triangle whose tip sits on the caret and
    // whose base meets the panel's top edge. It lives in the transparent shadow reserve, so
    // it is a sibling of the panel: it paints over the shadow band the panel casts upwards
    // and never over the panel itself. The whole shape is drawn only when the placement pass
    // produced a clean one -- a window flipped above the caret or pushed sideways has no
    // straight line back to it.
    //
    // The shape is a filled staircase of 1dp columns, not a `Path`. The software renderer
    // this project ships stubs `draw_path` out to nothing, exactly as it stubs
    // `draw_box_shadow` (the reason the shadow layers above are rings): a `Path` element is
    // declared, takes its place in the scene, and paints no pixels at all. Twelve columns of
    // 1dp are what this renderer can draw, and a 1dp-wide silhouette of the triangle is
    // within a pixel of the shape 3.1.1 specifies. The stroke a filled path would have
    // carried on its slanted edges is dropped with the path: the fill is the panel's own
    // opaque colour against the dark shadow band, and a 1dp diagonal stroke is not drawable
    // as columns without doubling the arrow's width. The table below is the triangle the two
    // metrics describe -- twelve columns, none taller than `cursor-arrow-height` -- and
    // changing either metric means re-deriving the table with them.
    private property <[length]> arrow-column-heights:
        [1px, 2px, 3px, 4px, 5px, 6px, 6px, 5px, 4px, 3px, 2px, 1px];

    if root.arrow-visible: Rectangle {
        x: CandidateMetrics.shadow-margin + root.arrow-x;
        y: CandidateMetrics.shadow-margin + root.arrow-y;
        width: CandidateMetrics.cursor-arrow-width;
        height: CandidateMetrics.cursor-arrow-height;
        background: transparent;

        for h[i] in root.arrow-column-heights: Rectangle {
            x: i * 1px;
            y: parent.height - h;
            width: 1px;
            height: h;
            background: Theme.surface-fill;
        }
    }

    // L0 base and L4 stroke: the stroke is drawn inside the border, so it never changes
    // the container's outer size.
    Rectangle {
        x: CandidateMetrics.shadow-margin + root.panel-x;
        y: CandidateMetrics.shadow-margin + root.panel-y;
        width: root.panel-width;
        height: root.panel-height;
        border-radius: root.container-radius;
        background: Theme.surface-fill;
        border-width: CandidateMetrics.stroke-width;
        border-color: Theme.surface-stroke;
        // The appear motion shrinks the panel and there is no transform to shrink its content
        // with, so the content keeps its own size and is cut at the panel's edge. Clipping is
        // what keeps a shrunk panel from drawing its cells out into the transparent reserve.
        clip: true;
        // 3.3.2's fade half. The adapter writes `window-opacity` from the appear motion
        // every frame it moves, and this subtree composites at that alpha, so the panel
        // fades in while it grows out of the caret and out while it shrinks. The renderer
        // side is pinned by the pixel probes in `src/renderer/tests.rs`: a bound opacity is
        // multiplied into the state alpha, and a subtree at alpha 0.01 or below draws
        // nothing. The binding is deliberately on the panel alone: the shadow bands' alpha
        // is baked into their per-band colours and follows the panel's geometry already, so
        // the shade holds its strength while the panel fades; if the appear frames ever
        // read better with the whole floating layer fading, this is the one binding to
        // widen, not a second one to add beside it.
        opacity: min(root.window-opacity, 1.0);

        VerticalLayout {
            spacing: 0;

            Header {
                strip-height: root.header-height;
                before: root.preedit-before;
                after: root.preedit-after;
                caret-visible: root.caret-visible;
                truncated: root.preedit-truncated;
                show-secondary-status: root.show-secondary-status;
                mode-label: root.mode-label;
                input-full: root.input-full;
                full-width: root.full-width;
                punctuation-full: root.punctuation-full;
                readonly: root.readonly;
                chinese: root.chinese;
            }

            Rectangle {
                height: CandidateMetrics.separator-height;
                background: Theme.separator;
            }

            // The candidate area slides as one during a page turn. The offset cannot be
            // written on `CandidateGrid` itself: a child of a layout takes its position from
            // the layout and rejects a binding of its own, which is why the grid sits in a
            // plain rectangle that carries the offset and owns the clip. The rectangle is
            // exactly as tall as the grid, so nothing below it moves.
            Rectangle {
                background: transparent;
                clip: true;
                height: root.grid-height;

                // Every geometry constant the grid draws with is bound here, from the global
                // that declares it: the grid itself cannot import this file.
                CandidateGrid {
                    x: root.page-offset-dp;
                    items: root.items;
                    item-count: root.item-count;
                    max-per-row: root.max-per-row;
                    rows: root.grid-rows;
                    show-annotation: root.show-annotation;
                    cell-width: root.cell-width;
                    cell-height: CandidateMetrics.cell-height;
                    cell-radius: root.cell-radius;
                    cell-padding-h: CandidateMetrics.cell-padding-h;
                    cell-padding-v: CandidateMetrics.cell-padding-v;
                    number-slot-width: CandidateMetrics.number-slot-width;
                    number-gap: CandidateMetrics.number-gap;
                    annotation-gap: CandidateMetrics.annotation-gap;
                    grid-gap: CandidateMetrics.grid-gap;
                    text-font-size: CandidateMetrics.font-size-cell;
                    small-font-size: CandidateMetrics.font-size-small;
                    area-padding: CandidateMetrics.container-padding;
                }
            }
        }

        // The highlight box (3.3.1): four springs move x, y, w and h independently, so a
        // cross-row move flies and reshapes instead of sliding, and mid-flight the box
        // overlaps two cells -- which is what the motion is meant to look like.
        //
        // Declared after the layout so it paints on top: a cell that painted over it would
        // clip the box the moment it left its own cell. Its coordinates are the grid's, so
        // the container padding and the header block are added here.
        //
        // The box is gated with `visible` and not with an opacity: it is either on a cell or
        // gone, and `visible` takes it out of the draw and the damage entirely, which a
        // zero-alpha subtree would still pay to composite. The window's own fade is the
        // panel's `opacity` binding above, not a property of the box.
        Rectangle {
            x: CandidateMetrics.container-padding + root.highlight-x;
            y: root.header-height + CandidateMetrics.separator-height
                + CandidateMetrics.container-padding + root.highlight-y;
            width: root.highlight-w;
            height: root.highlight-h;
            border-radius: root.cell-radius;
            background: Theme.state-selected-bg;
            border-width: 1px;
            border-color: Theme.state-selected-stroke;
            visible: root.highlight-visible;
        }
    }

    // The overlay panel (ADR-0006), a sibling of the panel declared after it so it
    // paints on top: while a panel is open it covers the candidates, and closing it
    // uncovers the frame beneath untouched. It rides the panel's own geometry -- the
    // shadow-margin inset, the appear-motion rectangle -- so the overlay and the panel
    // it replaces are one surface, and the shadow the panel casts keeps holding it up.
    // Gated with `visible` rather than an opacity: a closed overlay must leave no draw and
    // no damage at all, which is what keeps an idle window's frame count still -- a
    // zero-alpha subtree would still cost a compositing pass every frame. That the renderer
    // does honour a bound opacity (pinned by the pixel probes in `src/renderer/tests.rs`)
    // is what makes the cost argument the whole argument here.
    OverlayPanel {
        x: CandidateMetrics.shadow-margin + root.panel-x;
        y: CandidateMetrics.shadow-margin + root.panel-y;
        width: root.panel-width;
        height: root.panel-height;
        visible: root.overlay-visible;
        panel-title: root.overlay-title;
        sections: root.overlay-sections;
        radius: root.container-radius;
        stroke-width: CandidateMetrics.stroke-width;
        panel-padding: CandidateMetrics.container-padding;
        group-gap: CandidateMetrics.grid-gap;
        entry-gap: CandidateMetrics.number-gap;
        keys-label-gap: CandidateMetrics.header-text-gap;
        rule-height: CandidateMetrics.separator-height;
        title-font-size: CandidateMetrics.font-size-header;
        group-font-size: CandidateMetrics.font-size-small;
        entry-font-size: CandidateMetrics.font-size-small;
    }
}
