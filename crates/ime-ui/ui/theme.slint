// The candidate window's colour tokens (docs/dev/features.md 3.2), the light/dark
// switch, the acrylic base alpha, the two typographic tokens every run of text in
// the window draws with, and the band colours the two shadow layers of 3.1.2 are
// painted from.
//
// Imported by `candidate.slint`; this file is not compiled as a root document.
//
// `src/theme.rs` writes three of these properties on every theme switch -- `dark`,
// `accent` and `base-alpha` -- and every colour token derives from them. Three writes
// are what makes a theme switch a property update rather than a rebuild, which is what
// keeps a dark-to-light switch from flashing. The font family is the fourth property
// the Rust side writes and the one deliberately left out of a switch: it is resolved
// once at startup, because re-shaping every glyph is not something a switch may do.
//
// The values are the 3.2 table's, spelled the way the table spells them, because
// `scripts/check-ui-spec.sh` compares the two line by line; each token carries the
// table row it comes from. `src/theme.rs` repeats the same palette, because the
// contrast self-check has to evaluate it without a renderer; the two copies are
// pinned to each other byte for byte by `src/theme/slint_palette.rs` and by that
// script, and no third copy may exist.
//
// Alphas are written as the 0..1 fractions the table uses, and Slint turns them into
// the 8-bit channel two different ways: `with-alpha()` rounds the fraction, while the
// `rgba()` builtin truncates it. `src/theme.rs` therefore carries the byte each token
// actually paints with, which leaves seven of them one step below the rounded value.
//
// The shadow bands at the end of the global are the one thing here that is not a 3.2
// row: 3.1.2 fixes the two layers' geometry and colours, and the bands are how a layer
// with a blur radius is actually rasterized by the renderer this project ships. They
// are built from `shadow-outer` and `shadow-inner` and are declared beside them.

export global Theme {
    // True while the dark palette is in use. Written by `src/theme.rs`; `true` is the
    // documented default for a system that reports no preference.
    in property <bool> dark: true;

    // 3.2 `accent.default`. Written by `src/theme.rs` when the portal or the
    // configuration supplies one; the default follows the scheme.
    in property <color> accent: dark ? #4C9AFF : #0A6CFF;

    // 0.85 while the compositor blurs what is behind the window, 1.0 when it does
    // not. Written by `src/theme.rs` from the negotiation result and the contrast
    // self-check; it is the only value the degradation ladder changes.
    in property <float> base-alpha: 0.85;

    // -- typography (3.1.1, 3.1.4) ------------------------------------------

    // The CJK-capable family every run of text in the window draws with: the preedit,
    // the status label, the candidate numbers, the candidate text and its annotation.
    //
    // The default is the family every Linux baseline ships. The font probe in
    // `crates/ime-ui/src/renderer/probe.rs` measures which family this machine can
    // actually draw CJK with and the window takes that answer once, before the first
    // frame; a machine that can draw none keeps this value and reports
    // `ui/font/missing-cjk`. A theme switch never touches the property: a family change
    // would re-shape every glyph, and the window must not reflow on a dark-to-light
    // switch.
    //
    // `in-out` rather than `in`, because the property carries a value the window can
    // draw with on its own and the probe's answer replaces it -- the same shape as the
    // window's `container-width`, which the layout writes over the metrics default.
    in-out property <string> font-family: "Noto Sans CJK SC";

    // The optical nudge every run of text in the window takes (3.1.4).
    //
    // A run of CJK text centred by its em box does not read centred: the glyphs fill the
    // upper part of the box and leave the descender band empty, so the line sits about half
    // a pixel high next to a disc or a rule. The containers that hold text start their
    // content this much lower, and because they all read this one value the header line and
    // the candidate cells stay on one optical baseline. It is a sub-pixel calibration rather
    // than a grid size: the 4dp grid of 3.1.4 governs the window's geometry, and this sits
    // on top of it. The exact fraction is what a rendered frame has to confirm.
    out property <length> optical-nudge: 0.5px;

    // 3.2 `surface.base`, and the fill the panel is painted with. The fill is the
    // only token that carries the acrylic alpha: every other token is composited
    // over it by the renderer.
    out property <color> surface-base: dark ? #1C1C1E : #FFFFFF;
    out property <color> surface-fill: surface-base.with-alpha(base-alpha);

    // 3.2 `surface.stroke`
    out property <color> surface-stroke: dark ? rgba(255,255,255,0.10) : rgba(0,0,0,0.06);

    // 3.2 `text.*`
    out property <color> text-primary: dark ? #F2F2F7 : #1C1C1E;
    out property <color> text-secondary: dark ? rgba(242,242,247,0.62) : rgba(28,28,30,0.60);
    // The read-only lock's tint: the lock marker of the status strip and the `lock-color`
    // the status clusters show while input is read-only. The annotation text this token's
    // name recalls draws from `text-primary` at a folded element alpha instead.
    out property <color> text-annotation: dark ? rgba(242,242,247,0.48) : rgba(28,28,30,0.45);
    out property <color> text-separator: dark ? rgba(242,242,247,0.40) : rgba(28,28,30,0.35);

    // 3.2 `accent.on`: text drawn on top of a solid accent fill. Reserved: no surface
    // draws it yet. Enable it when the first solid-accent panel lands; until then the
    // deferral is carried by `DEFERRED_TOKENS` in `scripts/check-ui-spec.sh`.
    out property <color> accent-on: #FFFFFF;

    // 3.2 `state.*`
    out property <color> state-hover: dark ? rgba(242,242,247,0.08) : rgba(28,28,30,0.06);
    out property <color> state-selected-bg: accent.with-alpha(dark ? 0.18 : 0.14);
    out property <color> state-selected-stroke: accent.with-alpha(dark ? 0.55 : 0.50);
    out property <color> state-pressed: dark ? rgba(242,242,247,0.14) : rgba(28,28,30,0.12);

    // 3.2 `separator`
    out property <color> separator: dark ? rgba(242,242,247,0.10) : rgba(28,28,30,0.08);

    // 3.2 `shadow.*`: the two material layers of 3.1.2.
    out property <color> shadow-inner: dark ? rgba(0,0,0,0.35) : rgba(0,0,0,0.08);
    out property <color> shadow-outer: dark ? rgba(0,0,0,0.42) : rgba(0,0,0,0.16);

    // -- the two shadow layers, as bands (3.1.2) ----------------------------
    //
    // 3.1.2 draws L3 as `0 8dp 28dp shadow.outer` and L2 as `0 1dp 2dp shadow.inner`. The
    // window paints each layer as concentric rounded bands that tile outward from the
    // panel, so the cost follows the panel's perimeter rather than its area. A blur is a
    // falloff, and a run of equal-alpha bands does not make one: because the bands tile
    // without overlapping, the composite alpha at any point is exactly the alpha of the
    // single band covering it, so equal alphas composite to one flat wash with a hard
    // outer edge -- the cheapest-looking thing a floating panel can do.
    //
    // The falloff therefore has to reach the rasterizer as a per-band colour, which is
    // why the two tables below live here. An element `opacity` is one multiplier for a
    // whole subtree: it would scale every band by the same factor, and a falloff that
    // lives in the per-band alphas would come out the same wash at a lower peak. The
    // bands tile outward without overlapping, so the composite alpha at any point is the
    // alpha of the single band covering it -- the per-band colour is the only place this
    // ramp can live. That the renderer honours a bound `opacity` besides is pinned by
    // the pixel probes in `src/renderer/tests.rs`; the ramp is baked into `with-alpha()`
    // for the reason above, not because a binding would be dropped.
    //
    // Both tables are ordered outermost first, which is the order the drawing loop walks
    // them in: band 0 is the widest and faintest ring, the last band is the one hugging
    // the panel. `CandidateShadow` in `ui/candidate.slint` tiles each layer with exactly as
    // many rings as its table holds -- the counts are `CandidateMetrics.shadow-band-count`
    // and `shadow-inner-band-count` -- and paints ring `band` with the entry at that index.
    //
    // Each ramp's height is the alpha its last entry is built from, and that entry is the
    // only place the number lives: the ramp reaches the rasterizer as these colours, so a
    // separate peak scalar would be a number nothing reads. `src/theme/slint_palette.rs`
    // holds both tables to the falloff 3.1.2 describes.
    //
    // Each table is one line because `scripts/check-ui-spec.sh` reads this global one
    // declaration per line; a wrapped declaration is a gate error, not a style choice.

    // L3, the soft outer shadow: eight bands tiling the 28dp blur, each at the square of
    // its position in the ramp. The square is the tail a Gaussian blur of a straight edge
    // leaves behind, and it is why the bands are not evenly spaced in alpha -- a linear
    // ramp reads visibly too bright in the middle of the falloff. The alphas are
    // `0.18 * ((i + 1) / 8) ^ 2`, so the band against the panel paints at 0.18 -- 46 of
    // 255 -- and the outermost at 0.003, one step above nothing.
    //
    // 3.1.2 names that 0.18 as the layer's own alpha, so `with-alpha()` replaces the
    // token's rather than scaling it, and `shadow-outer` contributes the three channels
    // the ramp is painted in. Those channels are black in both schemes, which is why the
    // ramp reads the same on a light desktop and a dark one: the layer that has to stay
    // legible on both is the inner one, and that one does scale with its token.
    //
    // The 0.18 is the ramp's peak, and the entry below that hugs the panel is where it
    // lands.
    out property <[color]> shadow-outer-bands: [shadow-outer.with-alpha(0.0028125), shadow-outer.with-alpha(0.01125), shadow-outer.with-alpha(0.0253125), shadow-outer.with-alpha(0.045), shadow-outer.with-alpha(0.0703125), shadow-outer.with-alpha(0.10125), shadow-outer.with-alpha(0.1378125), shadow-outer.with-alpha(0.18)];

    // L2, the tight inner shadow: two bands of 1dp rather than one of 2dp, because a
    // single thick ring has a visible boundary where it meets the panel and reads as an
    // outline. The band hugging the panel carries three quarters of `shadow-inner`'s own
    // alpha and the one outside it carries a third, so the layer darkens the edge instead
    // of drawing a line on it. Both fractions are of the token's alpha, which is what
    // keeps the layer lighter in the light scheme than in the dark one.
    //
    // The three quarters is the weight of the band against the panel, and it is the last
    // entry below.
    out property <[color]> shadow-inner-bands: [shadow-inner.with-alpha(0.35 * (dark ? 0.35 : 0.08)), shadow-inner.with-alpha(0.75 * (dark ? 0.35 : 0.08))];

    // 3.2 `status.dot.*`
    out property <color> status-dot-active: accent;
    out property <color> status-dot-idle: dark ? rgba(242,242,247,0.35) : rgba(28,28,30,0.30);
}
